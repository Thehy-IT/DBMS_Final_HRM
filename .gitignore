# ============================================================
#   .gitignore — DBMS Final HRM Project
# ============================================================

# -----------------------------------------------------------
# Database connection & credentials (NEVER commit these!)
# -----------------------------------------------------------
*.config
*.env
.env
.env.*
connection.config
db.config
database.config
secrets.*
*.pem

# -----------------------------------------------------------
# SQL Server / Database files
# -----------------------------------------------------------
*.mdf
*.ldf
*.ndf
*.bak
*.trn
*.sqlproj.user

# -----------------------------------------------------------
# OS generated files
# -----------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# -----------------------------------------------------------
# IDEs & Editors
# -----------------------------------------------------------
# Visual Studio Code
.vscode/
!.vscode/extensions.json

# Visual Studio
*.suo
*.user
*.userosscache
*.sln.docstates
.vs/
[Dd]ebug/
[Rr]elease/
[Bb]in/
[Oo]bj/

# JetBrains (DataGrip, Rider...)
.idea/
*.iml

# -----------------------------------------------------------
# Application / Runtime artifacts
# -----------------------------------------------------------
# Logs
logs/
*.log
*.log.*

# Temporary files
*.tmp
*.temp
~$*

# Cache
__pycache__/
*.pyc
*.pyo
*.pyd
.cache/
*.cache

# Node.js
node_modules/
dist/
build/
.npm/
*.tsbuildinfo
next-env.d.ts

# Next.js
.next/
out/
.vercel

# Package managers
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# -----------------------------------------------------------
# Reporting / Export outputs
# -----------------------------------------------------------
03_App/reports/*.pdf
03_App/reports/*.xlsx
03_App/reports/*.csv
04_Testing/*.result
04_Testing/*.out

# -----------------------------------------------------------
# Documentation build artifacts
# -----------------------------------------------------------
05_Docs/*.pdf
05_Docs/~*

# -----------------------------------------------------------
# Antigravity CLI (AI assistant workspace)
# -----------------------------------------------------------
.antigravitycli/

# ============================================================
# 🚨 SECURITY & CREDENTIALS (CRITICAL)
# ============================================================
# Secrets & Credentials
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
*.pkcs12
*.jks
*.keystore

# Private npm / yarn / pnpm configs (Might contain auth tokens)
.npmrc
.yarnrc
.npmrc.local
.yarnrc.yml

# Database files (local)
*.sqlite
*.sqlite3
*.db
*.db-journal

# Cloud / CI/CD Credentials
.aws/
.gcp/
credentials.json
google-auth.json

# Miscellaneous Secrets
.secret
.secrets
*.rsa
*.dsa
*.ecdsa
*.ed25519
ssh_host_*
*.config.backup
